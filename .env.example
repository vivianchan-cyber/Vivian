# Copy this file's keys into Vercel → Project → Settings → Environment Variables.
# Never commit a real key. This .example file is safe to commit (no secrets).

# Your Twelve Data API key (free signup at https://twelvedata.com/pricing).
# Without it, the dashboard runs on its baked-in 13–14 Jul snapshot.
TWELVEDATA_API_KEY=

# Optional: seconds the server reuses a quote before calling the provider again.
# Higher = fewer API credits burned. Default 60. Raise to 300 if you hit limits.
QUOTE_CACHE_SECONDS=60
